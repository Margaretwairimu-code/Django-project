# ==========================================
# Python Bytecode & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Virtual Environments (Local environments)
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/

# ==========================================
# Secret Keys & Environment Variables (Crucial!)
# ==========================================
.env
.env.[a-zA-Z]*
!.env.example
local_settings.py
secrets.json

# ==========================================
# Databases & Persistent Storage
# ==========================================

*db.sqlite3
.sqlite3
*.db

# ==========================================
# Django Media & Static Collections
# ==========================================
# Ignore user-uploaded media files
media/

# Ignore gathered static assets (collected via collectstatic)
staticfiles/
static_cdn/

# ==========================================
# Logs & OS Specific Files
# ==========================================
*.log
.DS_Store
Thumbs.db

# ==========================================
# IDEs & Code Editors
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# Testing & Coverage
# ==========================================
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/